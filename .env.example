# Zyndicate frontend configuration.
# Copy to .env.local for local overrides. Only VITE_-prefixed variables are
# exposed to the browser — never put a secret in this file, it ships in the bundle.

# Origin of the coordination service. Leave EMPTY for local development: Vite
# proxies /api to http://localhost:4000 (see vite.config.ts).
#
# For a deployed build set it to the API origin, with no trailing slash:
#   VITE_API_BASE_URL=https://zyndicate-api.onrender.com
#
# That origin must list this site in its CORS_ORIGINS, otherwise the browser
# blocks every request.
VITE_API_BASE_URL=
